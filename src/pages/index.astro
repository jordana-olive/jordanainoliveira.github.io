---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import TimeLineElement from "../components/cv/TimeLine.astro";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
  <img
  src="hero4.png"
  alt="Overview of Amoebidium genome architecture"
  class="my-8 rounded-lg"
/>
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Jordana Oliveira</div>
    <div class="text-3xl py-3 font-bold">PhD in Genetics</div>
    <div class="py-2">
      <text class="text-lg">
        I'm a Biologist with a PhD in Genetics, passionate about understanding how species evolve using genomics approaches.
Currently, I'm a ​Marie Skłodowska-Curie Fellow in Alex de Mendoza's lab at Queen Mary University of London, UK. My project is investigating the role of small RNAs in immunity and regulation of giant endogenous viral elements in eukaryotes (#SMALLGIANT).
​</br>Follow below to learn more about my research, citizen science initiatives and perspectives.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="/projects" > My research</a>
      <a href="/cv" class="btn btn-outline ml-5">
        News!
      </a>
    </div>
  </div>

<div class="mb-10">
  <div class="text-3xl w-full font-bold mb-5">Academic timeline</div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="🇬🇧 2025 - current MSCA Fellow"
      subtitle="Queen Mary University of London, London, United Kingdom"
    />

    <TimeLineElement
      title=" 🇨🇦 2022 – 2025 Postdoctoral researcher"
      subtitle="University of Ottawa, Ottawa, Canada"
    />

    <TimeLineElement
      title="🇧🇷 2018 – 2022 PhD in Genetics"
      subtitle="São Paulo State University, Botucatu, Brazil "
    />

    <TimeLineElement
      title="🇧🇷 2016 – 2018 MSc in Genetics"
      subtitle="São Paulo State University, Botucatu, Brazil"
    />

    <TimeLineElement
      title="🇧🇷 2012 – 2016 Degree in Biology"
      subtitle="Ponta Grossa State University, Ponta Grossa, Brazil"
    />
  </div>
</div>



<div class="mt-16 pt-8 border-t border-gray-200">
  <blockquote class="max-w-2xl italic text-lg text-gray-600">
    “If you know you are on the right track, if you have this inner knowledge,
    then nobody can turn you off... no matter what they say.”
  </blockquote>

  <div class="mt-3 text-sm font-medium text-[#4a0d24]">
    — Barbara McClintock
  </div>
</div>


